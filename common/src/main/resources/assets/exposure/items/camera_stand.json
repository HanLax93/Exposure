{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": "fixed",
        "model": { "type": "minecraft:model", "model": "exposure:block/camera_stand" }
      },
      {
        "when": "none",
        "model": { "type": "minecraft:model", "model": "exposure:block/camera_stand_mount" }
      }
    ],
    "fallback": { "type": "minecraft:model", "model": "exposure:item/camera_stand" }
  }
}
